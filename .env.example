# Telegram bot (create one with @BotFather, then get the chat id from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where holdings come from: demo | csv | etoro
PORTFOLIO_SOURCE=demo
# Path to the holdings CSV when PORTFOLIO_SOURCE=csv
PORTFOLIO_CSV=data/sample_holdings.csv

# eToro API (PORTFOLIO_SOURCE=etoro). Create a key pair at https://api-portal.etoro.com/
# under Settings > Trading > API Key Management.
ETORO_API_KEY=
ETORO_USER_KEY=
ETORO_ACCOUNT=real

# Currency your holdings are expressed in
BASE_CURRENCY=USD

# Local files (git-ignored)
DB_PATH=portfolio_history.db
OUTPUT_DIR=output
